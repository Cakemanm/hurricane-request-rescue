<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.ShelterCardController"
      spacing="8.0"
      minHeight="-Infinity"
      style="-fx-background-color: #181a1a;
             -fx-background-radius: 16;
             -fx-padding: 14;">

    <Label fx:id="nameLabel"
           wrapText="true"
           style="-fx-text-fill: #8eb5d8;
                  -fx-font-size: 18;
                  -fx-font-weight: bold;" />

    <HBox spacing="16.0">
        <Label fx:id="travelTimeLabel"
               style="-fx-text-fill: white;" />

        <Label fx:id="spacesLabel"
               style="-fx-text-fill: white;" />
    </HBox>

    <HBox spacing="8.0">
        <Label fx:id="petFriendlyLabel"
               text="Pet Friendly"
               style="-fx-text-fill: white;
                      -fx-background-color: #254b82;
                      -fx-background-radius: 8;
                      -fx-padding: 4 8;" />

        <Label fx:id="medicalLabel"
               text="Medical"
               style="-fx-text-fill: white;
                      -fx-background-color: #254b82;
                      -fx-background-radius: 8;
                      -fx-padding: 4 8;" />
       <Label fx:id="accessibleLabel"
               text="Accessible"
               style="-fx-text-fill: white;
                      -fx-background-color: #254b82;
                      -fx-background-radius: 8;
                      -fx-padding: 4 8;" />
    </HBox>

</VBox>