<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.LoginController">
    <children>
      <Button fx:id="backWelcome" mnemonicParsing="false" onAction="#backWelcome" text="Back" />
        <Label text="Login" />
      <TextField fx:id="txt_username" promptText="Username" />
      <TextField fx:id="txt_password" promptText="Password" />
        <Button fx:id="loginButton" onAction="#login" text="Login" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
