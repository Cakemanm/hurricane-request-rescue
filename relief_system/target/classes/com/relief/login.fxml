<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefWidth="334.0" prefHeight="754.0" minWidth="300.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.LoginController"
      style="-fx-background-color: #1b2021; -fx-font-family: 'Arial';">
    <children>
        <Button fx:id="backWelcome" onAction="#backWelcome" text="&lt; Back"
                mnemonicParsing="false" alignment="CENTER_LEFT"
                maxWidth="Infinity" minHeight="45.0" prefHeight="45.0"
                style="-fx-background-color: #181a1b; -fx-background-radius: 0; -fx-border-color: #484b4c; -fx-border-width: 1; -fx-text-fill: #8eb5d9; -fx-font-size: 13px; -fx-padding: 0 8; -fx-cursor: hand;" />

        <VBox alignment="TOP_CENTER">
            <padding>
                <Insets top="70.0" left="24.0" right="11.0" />
            </padding>
            <children>
                <!-- A small vector approximation of the reference logo. -->
                <Pane minWidth="70.0" prefWidth="70.0" maxWidth="70.0"
                      minHeight="56.0" prefHeight="56.0" maxHeight="56.0">
                    <children>
                        <SVGPath fill="#29548e"
                                 content="M 2 44 C 17 48 16 30 21 20 C 26 10 37 7 45 6 C 53 0 61 -1 68 2 C 55 9 57 20 58 29 C 62 47 44 52 28 51 C 17 51 8 48 2 44 Z" />
                        <Circle centerX="39.0" centerY="27.0" radius="3.0" fill="#1b2021" />
                        <SVGPath fill="TRANSPARENT" stroke="#f47716" strokeWidth="2.0"
                                 strokeLineCap="ROUND"
                                 content="M 14 7 C 6 13 3 20 5 28 M 20 7 C 13 13 11 20 12 27 M 66 28 C 71 37 69 47 64 53 M 61 30 C 64 40 60 50 53 55 M 57 9 L 57 24 M 50 16 L 65 16 M 52 11 L 62 21 M 52 21 L 62 11" />
                    </children>
                </Pane>

                <Label text="Welcome Back"
                       style="-fx-text-fill: #cac9c4; -fx-font-size: 32px; -fx-font-weight: bold;">
                    <VBox.margin><Insets top="0.0" /></VBox.margin>
                </Label>
                <Label text="Log in to request help and&#10;check on your requests."
                       alignment="CENTER" textAlignment="CENTER" wrapText="true"
                       maxWidth="300.0"
                       style="-fx-text-fill: #8db5da; -fx-font-size: 18px; -fx-font-weight: bold;">
                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                </Label>

                <VBox fillWidth="true" maxWidth="400.0">
                    <VBox.margin><Insets top="19.0" left="14.0" /></VBox.margin>
                    <children>
                        <Label text="Username"
                               style="-fx-text-fill: #c5c5bf; -fx-font-size: 12px;" />
                        <TextField fx:id="txt_username" minHeight="40.0" prefHeight="40.0"
                                   style="-fx-background-color: #181a1b; -fx-background-radius: 5; -fx-border-color: #484c4d; -fx-border-radius: 5; -fx-text-fill: #eeeeee; -fx-font-size: 14px; -fx-padding: 8 10;">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </TextField>

                        <Label text="Password"
                               style="-fx-text-fill: #c5c5bf; -fx-font-size: 12px;">
                            <VBox.margin><Insets top="28.0" /></VBox.margin>
                        </Label>
                        <PasswordField fx:id="txt_password" minHeight="40.0" prefHeight="40.0"
                                       style="-fx-background-color: #181a1b; -fx-background-radius: 5; -fx-border-color: #484c4d; -fx-border-radius: 5; -fx-text-fill: #eeeeee; -fx-font-size: 14px; -fx-padding: 8 10;">
                            <VBox.margin><Insets top="4.0" /></VBox.margin>
                        </PasswordField>

                        <!-- Add onAction only after implementing password recovery. -->
                        <Hyperlink text="Forgot password ?" underline="true"
                                   style="-fx-text-fill: #8db5da; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 0; -fx-border-color: transparent;">
                            <VBox.margin><Insets top="24.0" /></VBox.margin>
                        </Hyperlink>

                        <Button fx:id="loginButton" onAction="#login" text="Log in"
                                defaultButton="true" mnemonicParsing="false" graphicTextGap="10.0"
                                maxWidth="Infinity" minHeight="40.0" prefHeight="40.0"
                                style="-fx-background-color: #233f70; -fx-background-radius: 5; -fx-border-color: #85a5ca; -fx-border-radius: 5; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;">
                            <VBox.margin><Insets top="64.0" /></VBox.margin>
                            <graphic>
                                <SVGPath fill="TRANSPARENT" stroke="WHITE" strokeWidth="2.0"
                                         strokeLineCap="ROUND" strokeLineJoin="ROUND"
                                         content="M 9 1 L 14 1 L 14 14 L 9 14 M 1 7.5 L 10 7.5 M 6 3.5 L 10 7.5 L 6 11.5" />
                            </graphic>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
    </children>
</VBox>
