<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ToggleButton?>

<VBox prefWidth="430.0" prefHeight="1000.0"
      style="-fx-background-color: #1c2222; -fx-font-family: 'Arial';"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controllers.BrowseSheltersController">

    <!-- Back bar -->
    <HBox alignment="CENTER_LEFT" minHeight="54.0"
          style="-fx-background-color: #191b1b; -fx-border-color: transparent transparent #424545 transparent; -fx-border-width: 0 0 1 0;">
        <padding><Insets left="12.0" /></padding>
        <Button mnemonicParsing="false" text="&lt; Back" onAction="#menu"
                style="-fx-background-color: transparent; -fx-text-fill: #8eb5d8; -fx-font-size: 16; -fx-cursor: hand;" />
    </HBox>

    <!-- Heading, search, and filters -->
    <VBox spacing="8.0" alignment="TOP_CENTER">
        <padding><Insets top="20.0" right="38.0" left="38.0" /></padding>

        <Text id="title" text="Browse Shelters" fill="#c9c6c1"
              style="-fx-font-size: 38;" />
        <Text text="Sorted by drive time from your location." fill="#8eb5d8"
              style="-fx-font-size: 15;" />

        <HBox alignment="CENTER_LEFT" spacing="14.0" minHeight="42.0"
              style="-fx-background-color: #181b1b; -fx-background-radius: 22;">
            <padding><Insets top="4.0" right="14.0" bottom="4.0" left="16.0" /></padding>
            <SVGPath content="M 8 0 A 8 8 0 1 0 8 16 A 8 8 0 1 0 8 0 M 14 14 L 21 21"
                     fill="TRANSPARENT" stroke="#8eb5d8" strokeWidth="2.0"
                     scaleX="0.8" scaleY="0.8" />
            <TextField fx:id="searchField" onAction="#search"
                       promptText="Search by name or area" HBox.hgrow="ALWAYS"
                       prefWidth="240.0" minWidth="0.0"
                       style="-fx-background-color: transparent; -fx-text-fill: #e5e5e5; -fx-prompt-text-fill: #606767; -fx-font-size: 15; -fx-padding: 4 0;" />
        </HBox>

        <FlowPane hgap="34.0" vgap="8.0" prefWrapLength="354.0">
            <ToggleButton fx:id="petFriendlyButton"
              text="+ Pet Friendly"
              onAction="#togglePetFriendly" />

<ToggleButton fx:id="medicalButton"
              text="+ Medical Staff"
              onAction="#toggleMedicalStaff" />

<ToggleButton fx:id="accessibleButton"
              text="+ Accessible"
              onAction="#toggleAccessibility" />
        </FlowPane>
    </VBox>

    <!-- Your controller adds the existing shelter cards here. -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                minHeight="0.0" VBox.vgrow="ALWAYS"
                style="-fx-background: #1c2222; -fx-background-color: #1c2222; -fx-background-insets: 0; -fx-padding: 0;">
        <VBox fx:id="shelterContainer" spacing="20.0">
            <padding><Insets top="24.0" right="22.0" bottom="16.0" left="22.0" /></padding>
        </VBox>
    </ScrollPane>

    <!-- Fixed footer -->
    <VBox>
        <padding><Insets top="18.0" right="40.0" bottom="28.0" left="40.0" /></padding>
        <Button mnemonicParsing="false" text="Return home" onAction="#home"
                maxWidth="Infinity" prefHeight="56.0" graphicTextGap="12.0"
                style="-fx-background-color: #1e2020; -fx-border-color: #505454; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #c9c6c1; -fx-font-size: 23; -fx-cursor: hand;">
            <graphic>
                <SVGPath content="M 1 14 L 16 1 L 31 14 M 5 11 L 5 32 L 12 32 L 12 21 L 20 21 L 20 32 L 27 32 L 27 11"
                         fill="TRANSPARENT" stroke="#c9c6c1" strokeWidth="2.5" />
            </graphic>
        </Button>
    </VBox>
</VBox>
