<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.WelcomeController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Relief Request" />
      <Button fx:id="loginScreenButton" onAction="#switchToLogin" text="Login" />
      <Button fx:id="signupScreenButton" layoutX="30.0" layoutY="104.0" onAction="#switchToSignUp" text="Sign-Up" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
