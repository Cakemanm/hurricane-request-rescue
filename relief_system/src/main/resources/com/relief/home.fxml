<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.HomeController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Relief Request" />
      <Text fx:id="dispaly_firstName" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
      <Text fx:id="dispaly_lastName" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
      <Text fx:id="dispaly_username" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
