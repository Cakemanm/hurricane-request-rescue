<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controllers.SignUpController">
   <children>
      <Button fx:id="backWelcome" mnemonicParsing="false" onAction="#backWelcome" text="Back" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Relief Request" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Sign Up" />
      <TextField fx:id="txt_firstName" promptText="First Name" />
      <TextField fx:id="txt_lastName" promptText="Last Name" />
      <TextField fx:id="txt_username" promptText="Username" />
      <TextField fx:id="txt_password" promptText="Password" />
      <Button fx:id="signupButton" layoutX="30.0" layoutY="104.0" onAction="#signup" text="Confirm Sign-Up" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>
</VBox>
